{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "观澜 Guanlan",
  "version": "0.1.7",
  "identifier": "dev.guanlan.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "观澜 · Guanlan",
        "width": 1320,
        "height": 880,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "观澜，本地代码助手",
    "category": "DeveloperTool"
  }
}
